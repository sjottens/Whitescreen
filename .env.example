# .env.example - Environment variables template

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://testascreen.com

# Analytics (optional)
NEXT_PUBLIC_GA_ID=

# API Configuration
NEXT_PUBLIC_API_URL=https://api.testascreen.com

# Environment
NODE_ENV=development

# Debug
DEBUG=false

# Gmail SMTP Configuration
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Cloudflare Turnstile (contact form + used laptop check). Without these the
# mail forms refuse every submission. Never commit the real secret.
# Production (Vercel): secret of the "testascreen forms" widget; leave the
# site key empty, the code defaults to that widget.
# Local (.env.local): the "localhost" widget, i.e.
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFRtDU1uJJQMxIF5, its secret, and
#   TURNSTILE_HOSTNAMES=localhost
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Comma-separated hostnames the forms run on; localhost only in .env.local
TURNSTILE_HOSTNAMES=testascreen.com,www.testascreen.com
