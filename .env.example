# .env.example - Environment variables template

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://testascreen.com

# Analytics (optional)
NEXT_PUBLIC_GA_ID=

# API Configuration
NEXT_PUBLIC_API_URL=https://api.testascreen.com

# Environment
NODE_ENV=development

# Debug
DEBUG=false

# Gmail SMTP Configuration
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
